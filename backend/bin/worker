#!/usr/bin/env node

import { validateEnvironment } from '../helpers/startupValidation.js';
validateEnvironment({ requireRedis: true, requireAuthSecrets: false });

import { QueueEvents } from 'bullmq';
import { createRoteiroWorker } from '../jobs/processRoteiroJob.js';
import { createBullmqConnection, getBullmqPrefix } from '../jobs/connection.js';
import { QUEUE_NAMES } from '../jobs/queueNames.js';
import db from '../Model/index.js';
import { AI_JOB_STATUS } from '../jobs/aiJobs.js';

let roteiroWorker = null;
let queueEvents = null;
let heartbeatRedis = null;
let heartbeatKey = null;
let shuttingDown = false;

async function startWorker() {
  roteiroWorker = createRoteiroWorker();

  roteiroWorker.on('ready', () => {
    console.log('[worker] fila de roteiro pronta');
  });

  roteiroWorker.on('completed', (job) => {
    console.log(`[worker] roteiro concluido para job ${job.id}`);
  });

  roteiroWorker.on('failed', (job, error) => {
    console.error(`[worker] falha no job ${job?.id || 'desconhecido'}:`, error.message);
  });

  // QueueEvents para detectar jobs travados (stalled)
  queueEvents = new QueueEvents(QUEUE_NAMES.ROTEIRO, {
    connection: createBullmqConnection(),
    prefix: getBullmqPrefix()
  });

  queueEvents.on('stalled', async ({ jobId }) => {
    console.warn(`[worker] job ${jobId} ficou stalled — sera retentado automaticamente`);
    try {
      const aiJob = await db.prisma.ai_jobs.findUnique({ where: { id: jobId } });
      if (aiJob && aiJob.status !== AI_JOB_STATUS.FAILED && aiJob.status !== AI_JOB_STATUS.COMPLETED) {
        await db.prisma.ai_jobs.update({
          where: { id: jobId },
          data: {
            last_error: `Stalled detectado em ${new Date().toISOString()} (tentativa ${aiJob.attempts_made || 0})`,
            updated_at: new Date()
          }
        });
      }
    } catch (err) {
      console.error(`[worker] erro ao registrar stalled job ${jobId}:`, err.message);
    }
  });

  await roteiroWorker.waitUntilReady();

  // Heartbeat via Redis — permite que a API verifique se o worker esta vivo
  heartbeatRedis = createBullmqConnection();
  heartbeatKey = `${getBullmqPrefix()}:worker:heartbeat`;

  async function writeHeartbeat() {
    try {
      const payload = JSON.stringify({
        uptime: Math.floor(process.uptime()),
        pid: process.pid,
        ts: Date.now()
      });
      await heartbeatRedis.setex(heartbeatKey, 90, payload);
    } catch (err) {
      console.error('[worker] erro ao escrever heartbeat:', err.message);
    }
  }

  await writeHeartbeat();
  setInterval(async () => {
    await writeHeartbeat();
    console.log(`[worker] heartbeat | uptime=${process.uptime().toFixed(0)}s`);
  }, 60_000);
}

async function gracefulShutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;

  console.log(`[worker] recebido ${signal}, encerrando...`);

  try {
    if (queueEvents) {
      await queueEvents.close();
    }
    if (roteiroWorker) {
      await roteiroWorker.close();
    }
    try {
      if (heartbeatRedis && heartbeatKey) {
        await heartbeatRedis.del(heartbeatKey);
        await heartbeatRedis.quit();
      }
    } catch (_) { /* best effort */ }
    process.exit(0);
  } catch (error) {
    console.error('[worker] erro ao encerrar worker:', error.message);
    process.exit(1);
  }
}

startWorker().catch((error) => {
  console.error('[worker] falha ao iniciar:', error);
  process.exit(1);
});

process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));
process.on('SIGINT', () => gracefulShutdown('SIGINT'));
