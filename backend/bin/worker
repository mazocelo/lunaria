#!/usr/bin/env node

import dotenv from 'dotenv';
dotenv.config();

import { validateEnvironment } from '../helpers/startupValidation.js';
validateEnvironment({ requireRedis: true, requireAuthSecrets: false });

import logger from '../helpers/logger.js';
const log = logger.child({ module: 'worker' });

import { QueueEvents } from 'bullmq';
import { createRoteiroWorker } from '../jobs/processRoteiroJob.js';
import { createImageWorker } from '../jobs/processImageJob.js';
import { createAudioWorker } from '../jobs/processAudioJob.js';
import { createBullmqConnection, getBullmqPrefix } from '../jobs/connection.js';
import { QUEUE_NAMES } from '../jobs/queueNames.js';
import db from '../Model/index.js';
import { AI_JOB_STATUS } from '../jobs/aiJobs.js';

let roteiroWorker = null;
let imageWorker = null;
let audioWorker = null;
const queueEventsList = [];
let heartbeatRedis = null;
let heartbeatKey = null;
let shuttingDown = false;

function setupWorkerEvents(worker, queueName) {
  worker.on('ready', () => {
    log.info({ queue: queueName }, 'fila pronta');
  });

  worker.on('completed', (job) => {
    log.info({ queue: queueName, jobId: job.id }, 'job concluido');
  });

  worker.on('failed', (job, error) => {
    log.error({ queue: queueName, jobId: job?.id, err: error }, 'falha no job');
  });
}

function setupStalledDetection(queueName) {
  const events = new QueueEvents(queueName, {
    connection: createBullmqConnection(),
    prefix: getBullmqPrefix()
  });

  events.on('stalled', async ({ jobId }) => {
    log.warn({ queue: queueName, jobId }, 'job ficou stalled — sera retentado automaticamente');
    try {
      const aiJob = await db.prisma.ai_jobs.findUnique({ where: { id: jobId } });
      if (aiJob && aiJob.status !== AI_JOB_STATUS.FAILED && aiJob.status !== AI_JOB_STATUS.COMPLETED) {
        await db.prisma.ai_jobs.update({
          where: { id: jobId },
          data: {
            last_error: `Stalled detectado em ${new Date().toISOString()} (tentativa ${aiJob.attempts_made || 0})`,
            updated_at: new Date()
          }
        });
      }
    } catch (err) {
      log.error({ queue: queueName, jobId, err }, 'erro ao registrar stalled job');
    }
  });

  queueEventsList.push(events);
}

async function startWorker() {
  // Criar workers para as 3 filas
  roteiroWorker = createRoteiroWorker();
  imageWorker = createImageWorker();
  audioWorker = createAudioWorker();

  setupWorkerEvents(roteiroWorker, QUEUE_NAMES.ROTEIRO);
  setupWorkerEvents(imageWorker, QUEUE_NAMES.IMAGE);
  setupWorkerEvents(audioWorker, QUEUE_NAMES.AUDIO);

  // Stalled detection para todas as filas
  setupStalledDetection(QUEUE_NAMES.ROTEIRO);
  setupStalledDetection(QUEUE_NAMES.IMAGE);
  setupStalledDetection(QUEUE_NAMES.AUDIO);

  await Promise.all([
    roteiroWorker.waitUntilReady(),
    imageWorker.waitUntilReady(),
    audioWorker.waitUntilReady()
  ]);

  // Heartbeat via Redis — permite que a API verifique se o worker esta vivo
  heartbeatRedis = createBullmqConnection();
  heartbeatKey = `${getBullmqPrefix()}:worker:heartbeat`;

  async function writeHeartbeat() {
    try {
      const payload = JSON.stringify({
        uptime: Math.floor(process.uptime()),
        pid: process.pid,
        queues: [QUEUE_NAMES.ROTEIRO, QUEUE_NAMES.IMAGE, QUEUE_NAMES.AUDIO],
        ts: Date.now()
      });
      await heartbeatRedis.setex(heartbeatKey, 90, payload);
    } catch (err) {
      log.error({ err }, 'erro ao escrever heartbeat');
    }
  }

  await writeHeartbeat();
  setInterval(async () => {
    await writeHeartbeat();
    log.info({ uptimeSeconds: Math.floor(process.uptime()) }, 'heartbeat');
  }, 60_000);
}

async function gracefulShutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;

  log.info({ signal }, 'recebido sinal, encerrando...');

  try {
    for (const events of queueEventsList) {
      await events.close();
    }
    if (roteiroWorker) await roteiroWorker.close();
    if (imageWorker) await imageWorker.close();
    if (audioWorker) await audioWorker.close();
    try {
      if (heartbeatRedis && heartbeatKey) {
        await heartbeatRedis.del(heartbeatKey);
        await heartbeatRedis.quit();
      }
    } catch (_) { /* best effort */ }
    process.exit(0);
  } catch (error) {
    log.error({ err: error }, 'erro ao encerrar worker');
    process.exit(1);
  }
}

startWorker().catch((error) => {
  log.error({ err: error }, 'falha ao iniciar');
  process.exit(1);
});

process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));
process.on('SIGINT', () => gracefulShutdown('SIGINT'));
