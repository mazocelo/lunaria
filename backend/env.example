# Configurações do Banco de Dados
# Para desenvolvimento local (sem senha):
DATABASE_URL=postgresql://localhost:5432/role_chat_game

# Para desenvolvimento local (com senha):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/role_chat_game

# Para produção (Heroku, Railway, etc.):
# DATABASE_URL=postgresql://usuario:senha@203.0.113.10:5432/lunaria

# Configurações do Redis
# Para desenvolvimento local:
REDIS_URL=redis://localhost:6379

# Para produção no Heroku (automaticamente definida pelo addon):
# REDIS_URL=redis://:password@hostname:port

# Configurações do Redis Upstash (produção)
# O sistema prioriza UPSTASH_REDIS_URL sobre REDIS_URL
# UPSTASH_REDIS_URL contém a URL completa com SSL (rediss://)
# UPSTASH_REDIS_URL=rediss://default:token@hostname:6379

# Variáveis REST do Upstash (opcionais, não usadas pelo código atual)
# UPSTASH_REDIS_REST_URL=https://hostname.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu_token_aqui

# Configurações da API
OPENAI_API_KEY=sua_chave_openai_aqui
GROQ_API_KEY=sua_chave_groq_aqui

# Configurações do Servidor
NODE_ENV=development
PORT=3000

# Configurações de Log
DEBUG=app:* 