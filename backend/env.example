# ===== CONFIGURACOES DO SERVIDOR =====
NODE_ENV=development
# Valores possiveis: development | production

PORT=3001
# Porta em que o servidor Express ira rodar
# Padrao: 3001

# ===== CONFIGURACOES DO FRONTEND (CORS) =====
FRONTEND_URL=http://localhost:5173
# URL do frontend para configuracao de CORS
# Desenvolvimento: http://localhost:5173 (ou a porta do seu frontend)
# Producao: https://lunaria-backend-3754d2d676ff.herokuapp.com (ou seu dominio)

# ===== CONFIGURACOES DO BANCO DE DADOS =====
# Para desenvolvimento local (sem senha):
DATABASE_URL=postgresql://localhost:5432/role_chat_game

# Para desenvolvimento local (com senha):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/role_chat_game

# Para producao (Heroku, Railway, etc.):
# DATABASE_URL=postgresql://usuario:senha@hostname:port/database

# ===== CONFIGURACOES DO REDIS =====
# Para desenvolvimento local:
REDIS_URL=redis://localhost:6379

# Para producao no Heroku (automaticamente definida pelo addon):
# REDIS_URL=redis://:password@hostname:port

# Configuracoes do Redis Upstash (producao)
# O sistema prioriza UPSTASH_REDIS_URL sobre REDIS_URL
# UPSTASH_REDIS_URL contem a URL completa com SSL (rediss://)
# UPSTASH_REDIS_URL=rediss://default:token@hostname:6379

# Variaveis REST do Upstash (opcionais, nao usadas pelo codigo atual)
# UPSTASH_REDIS_REST_URL=https://hostname.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu_token_aqui

# ===== FILA DE ROTEIRO (BULLMQ) =====
FF_AI_ASYNC_ROTEIRO=false
# Ativa a geracao de roteiro via BullMQ em vez de IIFE no processo web

BULLMQ_PREFIX=rolechat
# Prefixo usado pelo BullMQ nas chaves do Redis

BULLMQ_ROTEIRO_CONCURRENCY=2
# Quantidade de jobs de roteiro processados em paralelo pelo worker

# ===== CONFIGURACOES DE AUTENTICACAO (JWT) =====
JWT_SECRET=rpg_chat_game_secret_key_MUDE_EM_PRODUCAO
# Chave secreta para assinar tokens JWT de acesso
# IMPORTANTE: Altere este valor em producao para uma string aleatoria e segura
# Exemplo: openssl rand -base64 32

JWT_REFRESH_SECRET=rpg_chat_game_refresh_secret_MUDE_EM_PRODUCAO
# Chave secreta para assinar tokens JWT de refresh
# IMPORTANTE: Altere este valor em producao para uma string aleatoria e segura
# Deve ser diferente de JWT_SECRET

# ===== CONFIGURACOES DE APIS EXTERNAS =====
OPENAI_API_KEY=sua_chave_openai_aqui
# Chave da API OpenAI (opcional, se usar OpenAI)

GROQ_API_KEY=sua_chave_groq_aqui
# Chave da API Groq (usada pelos agentes de IA)

# ===== CONFIGURACOES DE EMAIL (Nodemailer) =====
SMTP_HOST=smtp.gmail.com
# Servidor SMTP (Gmail, Outlook, Mailtrap, etc.)

SMTP_PORT=587
# Porta SMTP (587 para TLS, 465 para SSL)

SMTP_USER=seuemail@gmail.com
# Usuario SMTP (email)

SMTP_PASS=sua_senha_de_app_aqui
# Senha de app do email (para Gmail: https://myaccount.google.com/apppasswords)

SMTP_FROM=noreply@lunaria.com
# Endereco do remetente exibido nos emails

# ===== OPEN SOURCE TTS =====
DEFAULT_TTS_PROVIDER=opensource
# Provider padrao do backend para listagem, preview e geracao de audio

OPEN_SOURCE_TTS_URL=http://localhost:8002
# URL do microservico local de TTS open source

OPEN_SOURCE_TTS_DEFAULT_VOICE_ID=pt-br-feminina
# Voz padrao usada quando o cliente nao informar voiceId

# ===== CONFIGURACOES DE LOG =====
DEBUG=app:*
# Niveis de debug do Express
# Valores: app:* | app:server | app:error | etc.
