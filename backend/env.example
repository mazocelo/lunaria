# ===== CONFIGURAÇÕES DO SERVIDOR =====
NODE_ENV=development
# Valores possíveis: development | production

PORT=3001
# Porta em que o servidor Express irá rodar
# Padrão: 3001

# ===== CONFIGURAÇÕES DO FRONTEND (CORS) =====
FRONTEND_URL=http://localhost:5173
# URL do frontend para configuração de CORS
# Desenvolvimento: http://localhost:5173 (ou a porta do seu frontend)
# Produção: https://lunaria-backend-3754d2d676ff.herokuapp.com (ou seu domínio)

# ===== CONFIGURAÇÕES DO BANCO DE DADOS =====
# Para desenvolvimento local (sem senha):
DATABASE_URL=postgresql://localhost:5432/role_chat_game

# Para desenvolvimento local (com senha):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/role_chat_game

# Para produção (Heroku, Railway, etc.):
# DATABASE_URL=postgresql://usuario:senha@hostname:port/database

# ===== CONFIGURAÇÕES DO REDIS =====
# Para desenvolvimento local:
REDIS_URL=redis://localhost:6379

# Para produção no Heroku (automaticamente definida pelo addon):
# REDIS_URL=redis://:password@hostname:port

# Configurações do Redis Upstash (produção)
# O sistema prioriza UPSTASH_REDIS_URL sobre REDIS_URL
# UPSTASH_REDIS_URL contém a URL completa com SSL (rediss://)
# UPSTASH_REDIS_URL=rediss://default:token@hostname:6379

# Variáveis REST do Upstash (opcionais, não usadas pelo código atual)
# UPSTASH_REDIS_REST_URL=https://hostname.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu_token_aqui

# ===== CONFIGURAÇÕES DE AUTENTICAÇÃO (JWT) =====
JWT_SECRET=rpg_chat_game_secret_key_MUDE_EM_PRODUCAO
# Chave secreta para assinar tokens JWT de acesso
# ⚠️ IMPORTANTE: Altere este valor em produção para uma string aleatória e segura
# Exemplo: openssl rand -base64 32

JWT_REFRESH_SECRET=rpg_chat_game_refresh_secret_MUDE_EM_PRODUCAO
# Chave secreta para assinar tokens JWT de refresh
# ⚠️ IMPORTANTE: Altere este valor em produção para uma string aleatória e segura
# Deve ser diferente de JWT_SECRET

# ===== CONFIGURAÇÕES DE APIs EXTERNAS =====
OPENAI_API_KEY=sua_chave_openai_aqui
# Chave da API OpenAI (opcional, se usar OpenAI)

GROQ_API_KEY=sua_chave_groq_aqui
# Chave da API Groq (usada pelos agentes de IA)

# ===== CONFIGURAÇÕES DE LOG =====
DEBUG=app:*
# Níveis de debug do Express
# Valores: app:* | app:server | app:error | etc. 