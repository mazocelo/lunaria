{
  "name": "role-chat-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "check-db": "node check-db.js",
    "populate-data": "node populate-initial-data.js",
    "seed": "node populate-initial-data.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "heroku-postbuild": "npm install --include=dev && prisma generate && prisma db push --skip-generate --accept-data-loss",
    "deploy": "prisma migrate deploy && prisma generate"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^0.3.43",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/groq": "^0.2.1",
    "@langchain/openai": "^0.5.4",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "http-errors": "~1.6.3",
    "jade": "^0.31.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.20",
    "morgan": "~1.9.1",
    "nodemailer": "^8.0.1",
    "nodemon": "^3.1.9",
    "openai": "^4.93.0",
    "pg": "^8.16.0",
    "redis": "^4.7.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  }
}
