generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model classes {
  id          Int           @id(map: "classe_pkey") @default(autoincrement())
  nome        String        @unique(map: "classe_nome") @db.VarChar(100)
  custo       Int           @default(0)
  descricao   String?
  bonus       String?
  personagens personagens[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model desvantagens {
  id            Int       @id(map: "descantagens_pkey") @default(autoincrement())
  nome          String    @unique
  descricao     String
  custo         Int       @default(0)
  tipo          String[]  @default(["ativa"]) @db.VarChar(255)
  bonus         Json?
  restricao     Json?
  dano_base     String?
  efeito        Json?     @db.Json
  usar          Int?
  elemento      String[]  @db.VarChar(255)
  nivel         Int       @default(1)
  requisitos    Json?
  criada_em     DateTime? @db.Timestamptz(6)
  atualizada_em DateTime? @db.Timestamptz(6)

  @@index([nivel], map: "idx_desvantagem_nivel")
  @@index([usar], map: "idx_desvantagem_usar")
}

model raridades {
  id           Int            @id @default(autoincrement())
  nome         String         @unique @db.VarChar(50)
  cor          String?        @db.VarChar(30)
  ordem        Int            @default(0)
  equipamentos equipamentos[]
  monstros     monstros[]
}

model categorias_equipamento {
  id           Int            @id @default(autoincrement())
  nome         String         @unique @db.VarChar(100)
  icone        String?        @db.VarChar(10)
  ordem        Int            @default(0)
  equipamentos equipamentos[]
}

model categorias_monstro {
  id       Int        @id @default(autoincrement())
  nome     String     @unique @db.VarChar(100)
  icone    String?    @db.VarChar(10)
  ordem    Int        @default(0)
  monstros monstros[]
}

model equipamentos {
  id                     Int                      @id(map: "equipamento_pkey") @default(autoincrement())
  nome                   String
  descricao              String?
  tipo                   String[]
  bonus                  Json?                    @default("[]")
  dano_base              String?
  elemento               String[]                 @default([])
  requisitos             Json?
  numero                 Int?
  raridade_id            Int?
  origem_lore            String?
  vinculo                Json?
  categoria_id           Int?
  propriedades           String[]                 @default([])
  cargas                 Int?
  usos_por_dia           Int?
  peso                   Float?
  preco_sugerido         String?
  raridade_rel           raridades?               @relation(fields: [raridade_id], references: [id])
  categoria_rel          categorias_equipamento?  @relation(fields: [categoria_id], references: [id])
  personagem_equipamento personagem_equipamento[]

  @@index([categoria_id], map: "idx_equipamento_categoria")
  @@index([raridade_id], map: "idx_equipamento_raridade")
  @@index([numero], map: "idx_equipamento_numero")
}

model historias {
  id                      Int                     @id @default(autoincrement())
  nome                    String                  @db.VarChar(255)
  maximo_de_participantes Int?
  prologo                 String?
  descricao               String?
  status                  String?                 @default("ativa") @db.VarChar(255)
  criada_em               DateTime?               @db.Timestamptz(6)
  atualizada_em           DateTime?               @db.Timestamptz(6)
  id_usuario              Int?
  temas                   Int[]
  mestre_id               Int?
  deleted_at              DateTime?               @db.Timestamptz(6)
  usuarios                usuarios?               @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historias_id_usuario")
  mestres                 mestres?                @relation(fields: [mestre_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_historias_mestre_id")
  historias_convite       historias_convite[]
  historias_personagens   historias_personagens[]
  sessoes_jogo           sessoes_jogo[]

  @@index([id_usuario])
  @@index([status])
  @@index([deleted_at])
}

model personagem_desvantagem {
  personagem_id Int
  habilidade_id Int
  personagens   personagens @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "personagem_habilidade_personagem_id_fkey")

  @@id([personagem_id, habilidade_id], map: "personagem_habilidade_pkey")
}

model personagem_equipamento {
  personagem_id  Int
  equipamento_id Int
  equipamentos   equipamentos @relation(fields: [equipamento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  personagens    personagens  @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([personagem_id, equipamento_id])
}

model personagem_vantagem {
  desvantagem_id Int
  personagem_id  Int

  @@id([personagem_id, desvantagem_id])
}

model personagens {
  id                     Int                      @id(map: "personagem_pkey") @default(autoincrement())
  nome                   String
  nivel                  Int?                     @default(1)
  pontos_totais          Int?                     @default(0)
  pontos_iniciais        Int?                     @default(0)
  background             String?
  raca_id                Int?
  classe_id              Int?
  forca                  Int?                     @default(10)
  inteligencia           Int?                     @default(10)
  carisma                Int?                     @default(10)
  destreza               Int?                     @default(10)
  constituicao           Int?                     @default(10)
  agilidade              Int?                     @default(10)
  criado_em              DateTime?                @db.Timestamptz(6)
  atualizado_em          DateTime?                @db.Timestamptz(6)
  id_usuario             Int?
  xp_atual               Int?                     @default(0)
  xp_proximo_nivel       Int?                     @default(100)
  pontos_atributo_pendentes Int?                  @default(0)
  deleted_at             DateTime?                @db.Timestamptz(6)
  historias_personagens  historias_personagens[]
  personagem_desvantagem personagem_desvantagem[]
  personagem_equipamento personagem_equipamento[]
  usuarios               usuarios?                @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_personagens_id_usuario")
  classes                classes?                 @relation(fields: [classe_id], references: [id])
  racas                  racas?                   @relation(fields: [raca_id], references: [id])

  @@index([id_usuario])
  @@index([deleted_at])
  @@index([classe_id])
  @@index([raca_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model racas {
  id          Int           @id(map: "raca_pkey") @default(autoincrement())
  nome        String        @unique(map: "raca_nome") @db.VarChar(100)
  custo       Int           @default(0)
  descricao   String?
  bonus       String?
  personagens personagens[]
}

model temas {
  id        Int     @id @default(autoincrement())
  nome      String  @unique @db.VarChar(255)
  descricao String? @db.VarChar(255)
}

model usuarios {
  id                   Int                 @id @default(autoincrement())
  nome                 String              @db.VarChar(100)
  email                String              @unique @db.VarChar(150)
  senha                String              @db.VarChar(255)
  role                 String?             @default("player") @db.VarChar(20)
  deleted_at           DateTime?           @db.Timestamptz(6)
  reset_token          String?             @db.VarChar(500)
  reset_token_expires  DateTime?           @db.Timestamptz(6)
  historias            historias[]
  historias_convite    historias_convite[]
  personagens          personagens[]
  mestres              mestres[]

  @@index([deleted_at])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model vantagens {
  id            Int       @id(map: "habilidade_pkey") @default(autoincrement())
  nome          String    @unique(map: "habilidade_nome_key")
  descricao     String
  custo         Int       @default(0)
  tipo          String[]  @default(["ativa"]) @db.VarChar(255)
  bonus         Json?
  restricao     Json?
  dano_base     String?
  efeito        Json?     @db.Json
  usar          Int?
  elemento      String[]  @db.VarChar(255)
  nivel         Int       @default(1)
  requisitos    Json?
  criada_em     DateTime? @db.Timestamptz(6)
  atualizada_em DateTime? @db.Timestamptz(6)

  @@index([nivel], map: "idx_habilidade_nivel")
  @@index([usar], map: "idx_habilidade_usar")
  @@index([nivel], map: "idx_vantagem_nivel")
  @@index([usar], map: "idx_vantagem_usar")
}

model historias_personagens {
  id            Int         @id @default(autoincrement())
  historia_id   Int
  personagem_id Int
  papel         String?     @db.VarChar(50)
  historias     historias   @relation(fields: [historia_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_historia")
  personagens   personagens @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_personagem")

  @@unique([historia_id, personagem_id], map: "unq_historia_personagem")
  @@index([personagem_id])
}

model historias_convite {
  id            Int       @id @default(autoincrement())
  historia_id   Int
  usuario_id    Int
  status        String    @default("pendente") @db.VarChar(20)
  criado_em     DateTime? @default(now()) @db.Timestamp(6)
  respondido_em DateTime? @db.Timestamp(6)
  historias     historias @relation(fields: [historia_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_historia")
  usuarios      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario")

  @@unique([historia_id, usuario_id], map: "unq_convite")
  @@index([usuario_id])
  @@index([status])
}

model mestres {
  id               Int        @id @default(autoincrement())
  nome             String     @db.VarChar(100)
  descricao        String?
  personalidade    String?
  modelo           String?    @default("openai/gpt-oss-120b") @db.VarChar(100)
  temperatura      Float?     @default(0.9)
  max_tokens       Int?       @default(8000)
  tom_narrativo    String?    @db.VarChar(255)
  regras_especiais String?
  imagem           String?    @db.VarChar(500)
  id_usuario       Int
  criado_em        DateTime?  @default(now()) @db.Timestamptz(6)
  atualizado_em    DateTime?  @db.Timestamptz(6)
  deleted_at       DateTime?  @db.Timestamptz(6)
  usuarios         usuarios   @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mestres_id_usuario")
  historias        historias[]

  @@index([id_usuario])
  @@index([deleted_at])
}

model monstros {
  id             Int        @id @default(autoincrement())
  nome           String     @unique @db.VarChar(150)
  descricao      String?
  tipo           String[]   @default(["besta"]) @db.VarChar(50)
  raridade_id    Int?
  categoria_id   Int?
  nivel_min      Int        @default(1)
  nivel_max      Int        @default(10)
  hp_base        Int        @default(15)
  forca          Int        @default(10)
  inteligencia   Int        @default(8)
  destreza       Int        @default(10)
  constituicao   Int        @default(10)
  agilidade      Int        @default(10)
  carisma        Int        @default(5)
  ataque_base    Int        @default(2)
  defesa_base    Int        @default(10)
  dano_base      String     @default("1d6") @db.VarChar(20)
  habilidades    Json?      @default("[]")
  elemento       String[]   @default([]) @db.VarChar(50)
  temas          String[]   @default([]) @db.VarChar(50)
  xp_base        Int        @default(50)
  criado_em      DateTime?  @default(now()) @db.Timestamptz(6)
  atualizado_em  DateTime?  @db.Timestamptz(6)
  raridade_rel   raridades?          @relation(fields: [raridade_id], references: [id])
  categoria_rel  categorias_monstro? @relation(fields: [categoria_id], references: [id])

  @@index([nivel_min, nivel_max], map: "idx_monstro_nivel")
  @@index([raridade_id], map: "idx_monstro_raridade")
  @@index([categoria_id], map: "idx_monstro_categoria")
}

model sessoes_jogo {
  id              Int       @id @default(autoincrement())
  historia_id     Int
  sala_id         String    @unique @db.VarChar(100)
  estado          Json      // snapshot completo do estadoJogo
  mensagens       Json      // array de mensagens
  resumos         Json?     // array de resumos
  jogadores       Json      // map de jogadores conectados
  status          String    @default("ativa") @db.VarChar(20)
  rodada_atual    Int       @default(0)
  fase            String?   @db.VarChar(50)
  iniciada_em     DateTime? @db.Timestamptz(6)
  finalizada_em   DateTime? @db.Timestamptz(6)
  ultimo_snapshot DateTime  @default(now()) @db.Timestamptz(6)
  criada_em       DateTime  @default(now()) @db.Timestamptz(6)
  atualizada_em   DateTime  @updatedAt @db.Timestamptz(6)

  historia        historias @relation(fields: [historia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([historia_id])
  @@index([status])
}

enum enum_habilidades_categoria {
  combate
  magia
  social
  exploracao
  sobrevivencia
  artesanato
  outros
}

enum enum_habilidades_raridade {
  comum
  incomum
  rara
  epica
  lendaria
}

enum enum_habilidades_status {
  ativa
  inativa
  rascunho
}

enum enum_habilidades_tipo {
  ativa
  passiva
  reacao
  ritual
}
