generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model classes {
  id          Int           @id(map: "classe_pkey") @default(autoincrement())
  nome        String        @unique(map: "classe_nome") @db.VarChar(100)
  custo       Int           @default(0)
  descricao   String?
  bonus       String?
  personagens personagens[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model desvantagens {
  id            Int       @id(map: "descantagens_pkey") @default(autoincrement())
  nome          String    @unique
  descricao     String
  custo         Int       @default(0)
  tipo          String[]  @default(["ativa"]) @db.VarChar(255)
  bonus         Json?
  restricao     Json?
  dano_base     String?
  efeito        Json?     @db.Json
  usar          Int?
  elemento      String[]  @db.VarChar(255)
  nivel         Int       @default(1)
  requisitos    Json?
  criada_em     DateTime? @db.Timestamptz(6)
  atualizada_em DateTime? @db.Timestamptz(6)

  @@index([nivel], map: "idx_desvantagem_nivel")
  @@index([usar], map: "idx_desvantagem_usar")
}

model equipamentos {
  id                     Int                      @id(map: "equipamento_pkey") @default(autoincrement())
  nome                   String
  descricao              String?
  tipo                   String[]
  bonus                  Json?                    @default("[]")
  restricao              Json?
  dano_base              String?
  efeito                 Json?
  elemento               String[]                 @default([])
  requisitos             Json?
  personagem_equipamento personagem_equipamento[]
}

model historias {
  id                      Int                     @id @default(autoincrement())
  nome                    String                  @db.VarChar(255)
  maximo_de_participantes Int?
  prologo                 String?
  descricao               String?
  status                  String?                 @default("ativa") @db.VarChar(255)
  criada_em               DateTime?               @db.Timestamptz(6)
  atualizada_em           DateTime?               @db.Timestamptz(6)
  id_usuario              Int?
  temas                   Int[]
  usuarios                usuarios?               @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historias_id_usuario")
  historias_convite       historias_convite[]
  historias_personagens   historias_personagens[]
}

model personagem_desvantagem {
  personagem_id Int
  habilidade_id Int
  personagens   personagens @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "personagem_habilidade_personagem_id_fkey")

  @@id([personagem_id, habilidade_id], map: "personagem_habilidade_pkey")
}

model personagem_equipamento {
  personagem_id  Int
  equipamento_id Int
  equipamentos   equipamentos @relation(fields: [equipamento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  personagens    personagens  @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([personagem_id, equipamento_id])
}

model personagem_vantagem {
  desvantagem_id Int
  personagem_id  Int

  @@id([personagem_id, desvantagem_id])
}

model personagens {
  id                     Int                      @id(map: "personagem_pkey") @default(autoincrement())
  nome                   String
  nivel                  Int?                     @default(1)
  pontos_totais          Int?                     @default(0)
  pontos_iniciais        Int?                     @default(0)
  background             String?
  raca_id                Int?
  classe_id              Int?
  forca                  Int?                     @default(10)
  inteligencia           Int?                     @default(10)
  carisma                Int?                     @default(10)
  destreza               Int?                     @default(10)
  constituicao           Int?                     @default(10)
  agilidade              Int?                     @default(10)
  criado_em              DateTime?                @db.Timestamptz(6)
  atualizado_em          DateTime?                @db.Timestamptz(6)
  id_usuario             Int?
  historias_personagens  historias_personagens[]
  personagem_desvantagem personagem_desvantagem[]
  personagem_equipamento personagem_equipamento[]
  usuarios               usuarios?                @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_personagens_id_usuario")
  classes                classes?                 @relation(fields: [classe_id], references: [id])
  racas                  racas?                   @relation(fields: [raca_id], references: [id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model racas {
  id          Int           @id(map: "raca_pkey") @default(autoincrement())
  nome        String        @unique(map: "raca_nome") @db.VarChar(100)
  custo       Int           @default(0)
  descricao   String?
  bonus       String?
  personagens personagens[]
}

model temas {
  id        Int     @id @default(autoincrement())
  nome      String  @unique @db.VarChar(255)
  descricao String? @db.VarChar(255)
}

model usuarios {
  id                Int                 @id @default(autoincrement())
  nome              String              @db.VarChar(100)
  email             String              @unique @db.VarChar(150)
  senha             String              @db.VarChar(255)
  role              String?             @default("player") @db.VarChar(20)
  historias         historias[]
  historias_convite historias_convite[]
  personagens       personagens[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model vantagens {
  id            Int       @id(map: "habilidade_pkey") @default(autoincrement())
  nome          String    @unique(map: "habilidade_nome_key")
  descricao     String
  custo         Int       @default(0)
  tipo          String[]  @default(["ativa"]) @db.VarChar(255)
  bonus         Json?
  restricao     Json?
  dano_base     String?
  efeito        Json?     @db.Json
  usar          Int?
  elemento      String[]  @db.VarChar(255)
  nivel         Int       @default(1)
  requisitos    Json?
  criada_em     DateTime? @db.Timestamptz(6)
  atualizada_em DateTime? @db.Timestamptz(6)

  @@index([nivel], map: "idx_habilidade_nivel")
  @@index([usar], map: "idx_habilidade_usar")
  @@index([nivel], map: "idx_vantagem_nivel")
  @@index([usar], map: "idx_vantagem_usar")
}

model historias_personagens {
  id            Int         @id @default(autoincrement())
  historia_id   Int
  personagem_id Int
  papel         String?     @db.VarChar(50)
  historias     historias   @relation(fields: [historia_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_historia")
  personagens   personagens @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_personagem")

  @@unique([historia_id, personagem_id], map: "unq_historia_personagem")
}

model historias_convite {
  id            Int       @id @default(autoincrement())
  historia_id   Int
  usuario_id    Int
  status        String    @default("pendente") @db.VarChar(20)
  criado_em     DateTime? @default(now()) @db.Timestamp(6)
  respondido_em DateTime? @db.Timestamp(6)
  historias     historias @relation(fields: [historia_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_historia")
  usuarios      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario")

  @@unique([historia_id, usuario_id], map: "unq_convite")
}

enum enum_habilidades_categoria {
  combate
  magia
  social
  exploracao
  sobrevivencia
  artesanato
  outros
}

enum enum_habilidades_raridade {
  comum
  incomum
  rara
  epica
  lendaria
}

enum enum_habilidades_status {
  ativa
  inativa
  rascunho
}

enum enum_habilidades_tipo {
  ativa
  passiva
  reacao
  ritual
}
