generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model classes {
  id          Int           @id(map: "classe_pkey") @default(autoincrement())
  nome        String        @unique(map: "classe_nome") @db.VarChar(100)
  custo       Int           @default(0)
  descricao   String?
  bonus       String?
  personagem  personagem[]
  personagens personagens[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model desvantagens {
  id            Int       @id(map: "descantagens_pkey") @default(autoincrement())
  nome          String    @unique
  descricao     String
  custo         Int       @default(0)
  tipo          String[]  @default(["ativa"]) @db.VarChar(255)
  bonus         Json?
  restricao     Json?
  dano_base     String?
  efeito        Json?     @db.Json
  usar          Int?
  elemento      String[]  @db.VarChar(255)
  nivel         Int       @default(1)
  requisitos    Json?
  criada_em     DateTime? @db.Timestamptz(6)
  atualizada_em DateTime? @db.Timestamptz(6)

  @@index([nivel], map: "idx_desvantagem_nivel")
  @@index([usar], map: "idx_desvantagem_usar")
}

model equipamento {
  id                     Int                      @id @default(autoincrement())
  nome                   String
  descricao              String?
  tipo                   String[]
  bonus                  Json?                    @default("[]")
  restricao              Json?
  dano_base              String?
  efeito                 Json?
  elemento               String[]                 @default([])
  requisitos             Json?
  personagem_equipamento personagem_equipamento[]
}

model historias {
  id                      Int       @id @default(autoincrement())
  temas                   String[]  @db.VarChar(255)
  nome                    String    @db.VarChar(255)
  maximo_de_participantes Int?
  participantes           String[]  @db.VarChar(255)
  prologo                 String?
  descricao               String?
  status                  String?   @default("ativa") @db.VarChar(255)
  criada_em               DateTime? @db.Timestamptz(6)
  atualizada_em           DateTime? @db.Timestamptz(6)
}

model personagem {
  id                     Int                      @id @default(autoincrement())
  nome                   String
  nivel                  Int                      @default(1)
  pontos_totais          Int                      @default(0)
  pontos_iniciais        Int                      @default(0)
  background             String?
  raca_id                Int?
  classe_id              Int?
  forca                  Int                      @default(0)
  inteligencia           Int                      @default(0)
  carisma                Int                      @default(0)
  destreza               Int                      @default(0)
  constituicao           Int                      @default(0)
  agilidade              Int                      @default(0)
  classes                classes?                 @relation(fields: [classe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  racas                  racas?                   @relation(fields: [raca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personagem_desvantagem personagem_desvantagem[]
  personagem_equipamento personagem_equipamento[]
}

model personagem_desvantagem {
  personagem_id Int
  habilidade_id Int
  personagem    personagem @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "personagem_habilidade_personagem_id_fkey")

  @@id([personagem_id, habilidade_id], map: "personagem_habilidade_pkey")
}

model personagem_equipamento {
  personagem_id  Int
  equipamento_id Int
  equipamento    equipamento @relation(fields: [equipamento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  personagem     personagem  @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([personagem_id, equipamento_id])
}

model personagem_vantagem {
  desvantagem_id Int
  personagem_id  Int

  @@id([personagem_id, desvantagem_id])
}

model personagens {
  id              Int       @id @default(autoincrement())
  nome            String
  nivel           Int?      @default(1)
  criado_em       DateTime? @db.Timestamptz(6)
  atualizado_em   DateTime? @db.Timestamptz(6)
  pontos_totais   Int?      @default(0)
  pontos_iniciais Int?      @default(0)
  background      String?
  raca_id         Int?
  classe_id       Int?
  forca           Int?      @default(10)
  inteligencia    Int?      @default(10)
  carisma         Int?      @default(10)
  destreza        Int?      @default(10)
  constituicao    Int?      @default(10)
  agilidade       Int?      @default(10)
  classes         classes?  @relation(fields: [classe_id], references: [id])
  racas           racas?    @relation(fields: [raca_id], references: [id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model racas {
  id          Int           @id(map: "raca_pkey") @default(autoincrement())
  nome        String        @unique(map: "raca_nome") @db.VarChar(100)
  custo       Int           @default(0)
  descricao   String?
  bonus       String?
  personagem  personagem[]
  personagens personagens[]
}

model temas {
  id   Int    @id @default(autoincrement())
  nome String @unique @db.VarChar(255)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model vantagens {
  id            Int       @id(map: "habilidade_pkey") @default(autoincrement())
  nome          String    @unique(map: "habilidade_nome_key")
  descricao     String
  custo         Int       @default(0)
  tipo          String[]  @default(["ativa"]) @db.VarChar(255)
  bonus         Json?
  restricao     Json?
  dano_base     String?
  efeito        Json?     @db.Json
  usar          Int?
  elemento      String[]  @db.VarChar(255)
  nivel         Int       @default(1)
  requisitos    Json?
  criada_em     DateTime? @db.Timestamptz(6)
  atualizada_em DateTime? @db.Timestamptz(6)

  @@index([nivel], map: "idx_habilidade_nivel")
  @@index([usar], map: "idx_habilidade_usar")
  @@index([nivel], map: "idx_vantagem_nivel")
  @@index([usar], map: "idx_vantagem_usar")
}

enum enum_habilidades_categoria {
  combate
  magia
  social
  exploracao
  sobrevivencia
  artesanato
  outros
}

enum enum_habilidades_raridade {
  comum
  incomum
  rara
  epica
  lendaria
}

enum enum_habilidades_status {
  ativa
  inativa
  rascunho
}

enum enum_habilidades_tipo {
  ativa
  passiva
  reacao
  ritual
}
