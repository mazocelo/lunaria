{
  "websocket": {
    "name": "Role Chat Game WebSocket API",
    "version": "2.1.0",
    "protocol": "Socket.IO",
    "default_url": "ws://localhost:3001",
    "last_reviewed": "2026-03-13",
    "source_of_truth": [
      "Backend/websocket/socketManager.js",
      "Backend/websocket/utils/turnStateMachine.js",
      "Backend/websocket/utils/testePipeline.js",
      "Frontend/src/store/socket/listeners.js",
      "Frontend/src/store/socket/send.js"
    ]
  },
  "principles": {
    "handshake_rule": "Connecting via Socket.IO is not enough. The client must emit authenticate before joining a room.",
    "bootstrap_event": "room_joined",
    "authoritative_live_state_event": "turno_estado_atualizado",
    "canonical_text_field": "message",
    "compatibility_text_field": "mensagem",
    "notes": [
      "room_joined delivers the persisted snapshot for session, messages and estadoJogo.",
      "turno_estado_atualizado is the authoritative event for turn status and pending tests.",
      "Legacy aliases may still appear inside sessao.estadoJogo for compatibility with older UI code."
    ]
  },
  "canonical_gameplay_path": {
    "client_to_server": [
      "authenticate",
      "join_room",
      "mensagem_para_mestre",
      "mensagem_roleplay",
      "dice_roll",
      "rolar_dado_inicial",
      "iniciar_turno",
      "status_update"
    ],
    "server_to_client": [
      "room_joined",
      "turno_estado_atualizado",
      "mestre_solicita_dados",
      "resultado_teste",
      "mensagem_mestre",
      "acao_mestre",
      "mensagem_roleplay",
      "turno_alterado",
      "rodada_finalizada",
      "nova_rodada_iniciada"
    ],
    "supported_but_non_primary": [
      "chat_message",
      "rpg_action",
      "solicitar_dados",
      "server_message"
    ],
    "notes": [
      "New gameplay clients should use mensagem_para_mestre as the canonical player action path.",
      "turno_estado_atualizado is the authoritative live state for turn progression and pending tests.",
      "chat_message remains supported for direct room chat or echo, but it is not the canonical RPG action input.",
      "solicitar_dados remains supported for admin, mestre tooling and internal/manual flows."
    ]
  },
  "client_to_server": {
    "authenticate": {
      "status": "canonical",
      "description": "Finalize websocket authentication for the current socket.",
      "required_fields": [
        "userId",
        "username"
      ],
      "optional_fields": [
        "sessionId",
        "email",
        "token"
      ],
      "success_events": [
        "authenticated"
      ],
      "error_events": [
        "error",
        "force_disconnect"
      ],
      "payload_shape": {
        "userId": "string",
        "username": "string",
        "sessionId": "string|null",
        "email": "string|null",
        "token": "string|null"
      }
    },
    "join_room": {
      "status": "canonical",
      "description": "Join a websocket room. Main flow uses historia_<id> rooms.",
      "required_fields": [
        "roomId",
        "userId"
      ],
      "optional_fields": [
        "username",
        "historiaId",
        "historiaData",
        "personagemId",
        "personagemNome",
        "sessionId"
      ],
      "success_events": [
        "room_joined",
        "user_joined"
      ],
      "error_events": [
        "error"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null",
        "historiaId": "string|null",
        "historiaData": "object|null",
        "personagemId": "string|number|null",
        "personagemNome": "string|null",
        "sessionId": "string|null"
      }
    },
    "leave_room": {
      "status": "canonical",
      "description": "Leave the current room.",
      "required_fields": [
        "roomId",
        "userId"
      ],
      "optional_fields": [
        "username"
      ],
      "success_events": [
        "room_left",
        "user_left"
      ],
      "error_events": [
        "error"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null"
      }
    },
    "chat_message": {
      "status": "supported_non_primary",
      "description": "Direct room chat message that does not go through the Mestre AI pipeline. Supported, but outside the canonical gameplay path.",
      "required_fields": [
        "roomId",
        "userId",
        "message"
      ],
      "optional_fields": [
        "username",
        "type"
      ],
      "success_events": [
        "chat_message"
      ],
      "error_events": [
        "error",
        "erro_mensagem"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null",
        "message": "string",
        "type": "string|null"
      }
    },
    "mensagem_para_mestre": {
      "status": "canonical",
      "description": "Main gameplay action. The player sends a narrated action to the Mestre pipeline.",
      "required_fields": [
        "roomId",
        "userId",
        "mensagem",
        "personagem"
      ],
      "optional_fields": [
        "username"
      ],
      "success_events": [
        "chat_message",
        "mensagem_mestre",
        "mestre_solicita_dados",
        "turno_estado_atualizado",
        "acao_mestre",
        "combate_iniciado",
        "combate_resultado_acao"
      ],
      "error_events": [
        "error",
        "erro_mensagem",
        "erro_turno"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null",
        "mensagem": "string",
        "personagem": {
          "nome": "string",
          "classe": "string|null",
          "nivel": "number|null",
          "id": "string|number|null",
          "personagemId": "string|number|null"
        }
      }
    },
    "mensagem_roleplay": {
      "status": "canonical",
      "description": "Side roleplay message for players outside the active turn.",
      "required_fields": [
        "roomId",
        "userId",
        "mensagem"
      ],
      "optional_fields": [
        "username"
      ],
      "success_events": [
        "mensagem_roleplay"
      ],
      "error_events": [
        "error",
        "erro_cooldown_roleplay"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null",
        "mensagem": "string"
      }
    },
    "rpg_action": {
      "status": "supported_non_primary",
      "description": "Structured lightweight action that bypasses the Mestre narrative pipeline. Supported for compatibility and side flows, but not recommended as the main gameplay input.",
      "required_fields": [
        "roomId",
        "userId",
        "action"
      ],
      "optional_fields": [
        "username",
        "target",
        "description"
      ],
      "success_events": [
        "rpg_action"
      ],
      "error_events": [
        "error"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null",
        "action": "string",
        "target": "string|null",
        "description": "string|null"
      }
    },
    "dice_roll": {
      "status": "canonical",
      "description": "Publish a dice roll. If the roll resolves a pending test, the server also emits resultado_teste and updates turn state.",
      "required_fields": [
        "roomId",
        "userId",
        "dice",
        "result"
      ],
      "optional_fields": [
        "username",
        "description"
      ],
      "success_events": [
        "dice_roll",
        "resultado_teste",
        "mensagem_mestre",
        "turno_estado_atualizado"
      ],
      "error_events": [
        "error",
        "teste_rejeitado"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null",
        "dice": "string",
        "result": "string|number",
        "description": "string|null"
      }
    },
    "rolar_dado_inicial": {
      "status": "canonical",
      "description": "Roll initiative d20 at the beginning of the adventure.",
      "required_fields": [
        "roomId",
        "userId"
      ],
      "optional_fields": [
        "username"
      ],
      "success_events": [
        "resultado_dado_inicial",
        "ordem_definida",
        "fase_atualizada",
        "turno_alterado"
      ],
      "error_events": [
        "error",
        "erro_dado_inicial"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null"
      }
    },
    "iniciar_turno": {
      "status": "canonical",
      "description": "Ask the Mestre to open the current player turn.",
      "required_fields": [
        "roomId",
        "userId"
      ],
      "optional_fields": [
        "username"
      ],
      "success_events": [
        "mensagem_mestre",
        "turno_iniciado",
        "turno_estado_atualizado",
        "mestre_solicita_dados"
      ],
      "error_events": [
        "error",
        "erro_turno"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null"
      }
    },
    "solicitar_dados": {
      "status": "internal_tooling",
      "description": "Manual data request, usually used by mestre/admin tooling and internal operational flows.",
      "required_fields": [
        "roomId",
        "motivo"
      ],
      "optional_fields": [
        "tipoTeste",
        "dificuldade",
        "jogadores"
      ],
      "success_events": [
        "mestre_solicita_dados",
        "turno_estado_atualizado"
      ],
      "error_events": [
        "error"
      ],
      "payload_shape": {
        "roomId": "string",
        "motivo": "string",
        "tipoTeste": "string|null",
        "dificuldade": "string|null",
        "jogadores": "array|null"
      }
    },
    "status_update": {
      "status": "canonical",
      "description": "Broadcast free-form player status to the room.",
      "required_fields": [
        "roomId",
        "userId",
        "status"
      ],
      "optional_fields": [
        "username",
        "details"
      ],
      "success_events": [
        "status_update"
      ],
      "error_events": [
        "error"
      ],
      "payload_shape": {
        "roomId": "string",
        "userId": "string",
        "username": "string|null",
        "status": "string",
        "details": "object|null"
      }
    }
  },
  "server_to_client": {
    "bootstrap_and_room": {
      "authenticated": {
        "status": "canonical",
        "payload_shape": {
          "userId": "string",
          "username": "string",
          "socketId": "string",
          "sessionId": "string|null"
        }
      },
