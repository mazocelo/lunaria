      "nova_rodada_iniciada": {
        "status": "canonical",
        "payload_shape": {
          "rodada": "integer",
          "primeiroJogador": "object|null",
          "timestamp": "integer"
        }
      }
    },
    "messages": {
      "chat_message": {
        "status": "supported_non_primary",
        "variants": {
          "direct_chat": {
            "id": "string",
            "userId": "string",
            "username": "string",
            "message": "string",
            "type": "string",
            "roomId": "string",
            "timestamp": "string"
          },
          "session_message_echo": {
            "id": "string",
            "tipo": "string",
            "canal": "string",
            "origem": "string",
            "userId": "string",
            "username": "string",
            "message": "string",
            "mensagem": "string",
            "payload": "object|null",
            "timestamp": "integer"
          }
        },
        "notes": [
          "New consumers should read message first.",
          "When tipo exists, the payload came from the persisted session message envelope.",
          "This event is still supported, but it is not the canonical path for formal player action in the RPG flow."
        ]
      },
      "mensagem_mestre": {
        "status": "canonical",
        "payload_shape": {
