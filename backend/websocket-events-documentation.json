          "tipo": "mestre",
          "canal": "formal|string",
          "origem": "turno|string",
          "userId": "mestre|string",
          "username": "Mestre|string",
          "message": "string",
          "mensagem": "string",
          "payload": "object|null",
          "voice_id": "string|null",
          "voice_provider": "string|null",
          "audio_cache_key": "string|null",
          "segmentos": "array",
          "timestamp": "integer"
        }
      },
      "mensagem_roleplay": {
        "status": "canonical",
        "payload_shape": {
          "id": "string",
          "tipo": "roleplay",
          "canal": "roleplay",
          "origem": "turno",
          "userId": "string",
          "username": "string",
          "message": "string",
          "mensagem": "string",
          "payload": {
            "cena": "integer"
          },
          "timestamp": "integer"
        }
      },
      "acao_mestre": {
        "status": "canonical",
        "payload_shape": {
          "id": "string",
          "tipo": "string",
          "userId": "string|null",
          "username": "string|null",
          "personagem": "string|null",
          "message": "string",
          "mensagem": "string",
          "payload": "object",
          "timestamp": "integer"
        }
      },
      "status_update": {
        "status": "canonical",
        "payload_shape": {
          "userId": "string",
          "username": "string",
          "status": "string",
          "details": "object|null",
          "roomId": "string",
          "timestamp": "integer"
        }
      },
      "dice_roll": {
        "status": "canonical",
        "description": "Echo of a player dice roll broadcast to the entire room. Emitted by testEngine after validating the roll. When the roll resolves a pending test, dadosSolicitados is true and resultado_teste follows.",
        "direction": "server_to_client",
        "payload_shape": {
          "id": "string",
          "userId": "string",
          "username": "string",
          "dice": "string",
          "result": "string",
          "description": "string|null",
          "roomId": "string",
          "timestamp": "integer",
          "dadosSolicitados": "boolean"
        }
      },
      "rpg_action": {
        "status": "supported_non_primary",
        "description": "Echo of a structured lightweight RPG action broadcast to the room. Emitted by socketManager after validation. Action is persisted to session history for historia_ rooms.",
        "direction": "server_to_client",
        "payload_shape": {
          "id": "string",
          "userId": "string",
          "username": "string",
          "action": "string",
          "target": "string|null",
          "description": "string|null",
          "roomId": "string",
          "timestamp": "string"
        }
      },
      "server_message": {
        "status": "canonical",
        "description": "Server-originated informational message broadcast to the room. Currently emitted when a defeated player attempts to act during combat.",
        "direction": "server_to_client",
        "payload_shape": {
          "userId": "string",
          "mensagem": "string"
        }
      }
    },
