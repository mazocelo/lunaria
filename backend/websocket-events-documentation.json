          "timestamp": "integer"
        }
      },
      "room_joined": {
        "status": "canonical",
        "payload_shape": {
          "roomId": "string",
          "users": "array",
          "sessao": {
            "status": "string",
            "historiaId": "string|number",
            "historiaNome": "string",
            "historiaTemas": "array",
            "historiaPrologo": "string|null",
            "mestreConfig": "object|null",
            "donoId": "string|number",
            "donoNome": "string",
            "maxJogadores": "number",
            "totalJogadores": "number",
            "jogadores": "object",
            "jogadoresConectados": "array",
            "estadoJogo": "object",
            "iniciadaEm": "string|null",
            "mensagens": "array"
          }
        }
      },
      "room_left": {
        "status": "canonical",
        "payload_shape": {
          "roomId": "string",
          "timestamp": "integer"
        }
      },
      "user_joined": {
        "status": "canonical",
        "payload_shape": {
          "userId": "string",
          "username": "string",
          "personagemId": "string|number|null",
          "personagemNome": "string|null",
          "status": "string",
          "roomId": "string",
          "timestamp": "integer",
          "isReconnection": "boolean"
        }
      },
      "user_left": {
        "status": "canonical",
        "payload_shape": {
          "userId": "string",
          "username": "string",
          "roomId": "string",
          "timestamp": "integer"
        }
      },
      "status_jogo_alterado": {
        "status": "secondary",
        "payload_shape": {
          "statusJogo": "string",
          "totalJogadores": "integer",
          "timestamp": "integer"
        }
      }
