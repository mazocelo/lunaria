      "javascript": "const socket = io('ws://localhost:3001', { transports: ['websocket', 'polling'], autoConnect: false });\\nsocket.connect();\\nsocket.emit('authenticate', { userId: '42', username: 'Marcelo', sessionId: Date.now().toString() });\\nsocket.on('authenticated', () => {\\n  socket.emit('join_room', {\\n    roomId: 'historia_123',\\n    userId: '42',\\n    username: 'Marcelo',\\n    historiaId: '123',\\n    personagemId: '987',\\n    personagemNome: 'Arannis',\\n    sessionId: Date.now().toString()\\n  });\\n});"
    },
